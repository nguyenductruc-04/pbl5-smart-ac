# Copy file nay thanh .env roi sua gia tri that. File .env KHONG duoc commit.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=gateway
MQTT_PASS=CHANGE_ME

# --- REST API ---
API_HOST=0.0.0.0
API_PORT=8000
# Tao moi khoa bang:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# API_KEY: cho app/dashboard (lenh cua nguoi dung). Bat buoc, >= 16 ky tu.
API_KEY=CHANGE_ME
# API_KEY_AUTOMATION: cho dich vu tu dong (luat, AI). De trong = tat dieu khien tu dong.
API_KEY_AUTOMATION=
# Dia chi truy cap tu xa qua Cloudflare Tunnel (SETUP.vi.md Buoc 13). App Android tu doc dia chi nay
# khi o mang nha, roi dung no khi ra ngoai. De trong = chi dung trong mang nha / mang du phong.
PUBLIC_URL=
# Mang cua Pi: auto (mac dinh) | standalone (chi phat Wi-Fi rieng, de di thu nghiem) | home
# Doi xong: sudo systemctl restart pbl5-netwatch. Ve nha nho doi lai auto.
NETWORK_MODE=auto

# Giao thuc IR mac dinh, chi dung khi node chua bao giao thuc (firmware < 0.11.0). Tu 0.11.0 doi tren dashboard.
IR_PROTOCOL=DAIKIN

# --- Safety Layer (bo dau # de doi; mac dinh xem gateway/safety.py, lop Policy) ---
# SAFETY_MIN_OFF_S=180
# SAFETY_HOLD_REMOTE_S=3600
# SAFETY_HOLD_APP_S=1800

# --- Goi y (M6) ---
# 1 = tu dong ap dung goi y (nguon "ai", van qua Safety Layer). Chay ben trong gateway, khong can API_KEY_AUTOMATION.
ADVISOR_AUTO=0
# ADVISOR_INTERVAL_S=60
